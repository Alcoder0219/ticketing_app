# ── Server ───────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed CORS origins (the Vite frontend)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/aum_dacro_ticketing
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/aum_dacro_ticketing
MONGODB_URI=mongodb://127.0.0.1:27017/aum_dacro_ticketing

# ── Auth ─────────────────────────────────────────────────
# Use a long random string in production (openssl rand -hex 48)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Storage ──────────────────────────────────────────────
# "local"      = files saved under ./uploads and served by this server
# "cloudinary" = files uploaded to Cloudinary; MongoDB stores only the secure_url
# (auto-selects cloudinary when the CLOUDINARY_* vars below are set)
STORAGE_DRIVER=cloudinary
STORAGE_DIR=uploads
# Public base URL this server is reachable at (used to build file URLs)
PUBLIC_BASE_URL=http://localhost:4000

# ── Cloudinary ───────────────────────────────────────────
# From Cloudinary Dashboard → Account Details. The API secret is sensitive:
# it lives ONLY here (server-side) and is never exposed to the frontend.
# Leave all three blank to fall back to local-disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email notifications (Gmail API + domain-wide delegation) ─────────────
# Variable names match the GatePass backend on purpose: the SAME Google service
# account and the SAME Workspace delegation grant serve both applications, so
# nothing new has to be authorised in Google Workspace.
#
# Credentials resolve in this order:
#   1. GMAIL_SERVICE_ACCOUNT_EMAIL + GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY
#      (Secret Manager / Cloud Run "Variables & Secrets")
#   2. GMAIL_SERVICE_ACCOUNT_KEY_PATH — local dev only, JSON key on disk
#   3. Application Default Credentials — the Cloud Run ATTACHED service account
#      signs its own delegated assertion via the IAM Credentials API. No private
#      key exists anywhere. PREFERRED IN PRODUCTION: leave 1 and 2 blank.
#
# For (3) the attached service account needs roles/iam.serviceAccountTokenCreator
# on ITSELF and the IAM Service Account Credentials API enabled.
GMAIL_ENABLED=false
GMAIL_SERVICE_ACCOUNT_EMAIL=
GMAIL_SERVICE_ACCOUNT_PRIVATE_KEY=
GMAIL_SERVICE_ACCOUNT_KEY_PATH=
# The Workspace user the service account impersonates — every automated
# ticketing email is sent AS this account.
GMAIL_IMPERSONATE_USER=alert@amsonsgroup.net
# Sender. MUST match GMAIL_IMPERSONATE_USER (or be a verified alias of it);
# only the display name is free text.
EMAIL_FROM="Amsons Group Support <alert@amsonsgroup.net>"

# Public URL of the FRONTEND — used to build "View Ticket" / "Rate This Ticket"
# links in emails. No trailing slash.
APP_BASE_URL=http://localhost:8080
# Optional: absolute URL of the company logo shown in the email header.
# Leave blank to fall back to the "Amsons Group" wordmark.
COMPANY_LOGO_URL=

# ── External integrations (ported from Supabase edge functions) ──
# Leave blank to disable that integration.
LOVABLE_API_KEY=
OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
